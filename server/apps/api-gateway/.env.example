PORT=5000
JWT_ACCESS_PUBLIC_KEY_PATH=../../keys/public.pem
JWT_ISSUER=salon-booking-auth
JWT_AUDIENCE=salon-booking-api

# Docker Deployment
APP_URL=http://localhost:8080
AUTH_SERVICE_URL=http://auth-service:5001
SALON_SERVICE_URL=http://salon-service:5002
BOOKING_SERVICE_URL=http://booking-service:5003
PAYMENT_SERVICE_URL=http://payment-service:5004
NOTIFICATION_SERVICE_URL=http://notification-service:5005
REDIS_URL=redis://redis:6379

# Local Development (Vite dev server usually port 5173)
