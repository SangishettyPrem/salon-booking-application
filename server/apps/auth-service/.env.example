PORT=5001
NODE_ENV=development

JWT_PRIVATE_KEY=generate your own private key
JWT_PUBLIC_KEY=generate your own public key
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=salon-booking-auth
JWT_AUDIENCE=salon-booking-api

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
PASSWORD_RESET_EXPIRES_MINUTES=15

# Docker Deployment
APP_URL=http://localhost:8080
MONGODB_URI=mongodb://mongodb:27017/salon_auth_db
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Local Development
# APP_URL=http://localhost:5173
# MONGODB_URI=mongodb://localhost:27017/salon_auth_db
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
